# apps/web settings. Server-only: none of these is NEXT_PUBLIC_, so none reaches a browser bundle.
# Copy to apps/web/.env.local for development.

# Base URL of the RecallOps API (component 1). Every call goes through the server; the API has no CORS.
RECALLOPS_API_URL=http://127.0.0.1:8000

# Console auth seam. "dev" sends X-Dev-Firm-Id / X-Dev-Role from the values below and works only against an API
# running AUTH_PROVIDER=dev. Any other value fails closed until the login owner (component 4) wires Clerk.
RECALLOPS_WEB_AUTH=dev
RECALLOPS_DEV_FIRM_ID=00000000-0000-4000-8000-00000000d001
RECALLOPS_DEV_ROLE=admin
RECALLOPS_DEV_USER_ID=dev-user

# Timeout for one API call from the web server, in milliseconds.
RECALLOPS_API_TIMEOUT_MS=30000
