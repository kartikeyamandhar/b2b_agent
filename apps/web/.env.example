# apps/web settings. All are server-only except NEXT_PUBLIC_CLERK_*, which Clerk's browser code reads by design
# (the publishable key is public). CLERK_SECRET_KEY and the RECALLOPS_* values never reach a browser bundle.
# Copy to apps/web/.env.local for development.

# Base URL of the RecallOps API (component 1). Every call goes through the server; the API has no CORS.
RECALLOPS_API_URL=http://127.0.0.1:8000

# Console auth seam: "clerk" (sign-in required; the Clerk session token goes to the API) or "dev", which sends
# X-Dev-Firm-Id / X-Dev-Role from the values below and works only against an API
# running AUTH_PROVIDER=dev and never in production. Any other value fails closed.
RECALLOPS_WEB_AUTH=dev
RECALLOPS_DEV_FIRM_ID=00000000-0000-4000-8000-00000000d001
RECALLOPS_DEV_ROLE=admin
RECALLOPS_DEV_USER_ID=dev-user

# Timeout for one API call from the web server, in milliseconds.
RECALLOPS_API_TIMEOUT_MS=30000

# ---- Clerk (RECALLOPS_WEB_AUTH=clerk). Copy the test-instance values into .env.local only; never commit them. ----
# The API must run with AUTH_PROVIDER=clerk and CLAIM_TOKEN_PROVIDER=hmac at the same time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# No keyless instances (they call Clerk's API) and no telemetry.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=true
