# RecallOps environment. Copy to .env (gitignored) and keep fake values unless you have a reason.
# Every variable read by apps/api/src/recallops/settings.py is listed here.

APP_ENV=dev
LOG_LEVEL=INFO

# Local Postgres (docker-compose.yml). Passwords are local-only development values.
POSTGRES_PORT=55432
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-only
RECALLOPS_OWNER_PASSWORD=owner-dev-only
RECALLOPS_APP_PASSWORD=app-dev-only
RECALLOPS_INTERNAL_PASSWORD=internal-dev-only
DATABASE_URL=postgresql://recallops_app:app-dev-only@localhost:55432/recallops
DATABASE_URL_INTERNAL=postgresql://recallops_internal:internal-dev-only@localhost:55432/recallops
DATABASE_URL_OWNER=postgresql://recallops_owner:owner-dev-only@localhost:55432/recallops

# Login seam (component 4). dev reads X-Dev-Firm-Id and X-Dev-Role headers.
AUTH_PROVIDER=dev
CLERK_SECRET_KEY=sk_test_fake
CLERK_PUBLISHABLE_KEY=pk_test_fake
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_ALLOWED_ORIGINS=http://localhost:3000
CLAIM_TOKEN_SECRET=ZmFrZS1jbGFpbS10b2tlbi1zZWNyZXQtMzItYnl0ZXM=
# dev: dev.<firm>.<claim> links, development only; hmac: the login owner's signed links (refuses the example secret)
CLAIM_TOKEN_PROVIDER=dev

# Payments seam (component 3). Test-mode keys only; the dev auth provider refuses to load with live keys.
STRIPE_SECRET_KEY=sk_test_fake
STRIPE_PUBLISHABLE_KEY=pk_test_fake
STRIPE_WEBHOOK_SECRET=whsec_fake
STRIPE_API_VERSION=2026-09-30.fake

INTERNAL_SHARED_SECRET=internal-dev-only

# Ingestion.
CPSC_API_BASE=https://www.saferproducts.gov/RestWebServices/Recall
HTTP_USER_AGENT=RecallOps research (student project)
CPSC_TIMEOUT_S=30
CPSC_WINDOW_DAYS=30
CPSC_PAUSE_S=2
RECALLBENCH_URL=https://recallbench.com/data/cpsc-recalls-full.csv

# Model (phase 0 decision in CLAUDE.md). LLM_MODE=live needs the owner's approval and a real key in .env.
LLM_MODE=replay
LLM_MODEL_ID=claude-haiku-5-5
ANTHROPIC_API_KEY=sk-ant-fake
# Prices are left commented out so the documented defaults in settings.py apply.
# LLM_PRICE_INPUT_PER_MTOK_USD=0.10
# LLM_PRICE_OUTPUT_PER_MTOK_USD=0.50
# LLM_PRICE_LONG_CONTEXT_THRESHOLD_TOKENS=100000
# LLM_PRICE_INPUT_LONG_PER_MTOK_USD=0.50
# LLM_PRICE_OUTPUT_LONG_PER_MTOK_USD=2.50
LLM_PRICES_CHECKED_ON=2026-10-06
LLM_CHARS_PER_TOKEN_ESTIMATE=2.0
LLM_IMAGE_PATCH_PX=28
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_S=30
LLM_BUDGET_STOP_USD=4.00
LLM_BUDGET_WARN_USD=3.00
LLM_SPEND_CARRIED_USD=0
REPLAY_DIR=evals/recordings
LLM_RECORD_DIR=data/generated/llm_recordings

# Caps (CLAUDE.md invariant 4) and extraction caps.
RUN_CAP_STEPS=8
RUN_CAP_USD=0.02
RUN_CAP_SECONDS=60
EXTRACT_RUN_CAP_USD=0.01
EXTRACT_MAX_CALLS=2

# Embeddings (decisions log 2026-10-18).
EMBEDDING_MODEL_ID=hash-ngram-v1
EMBEDDING_DIM=1024

# Claim photo storage. STORAGE_BACKEND=local writes under STORAGE_DIR (dev and tests; component owners never need
# real values locally). STORAGE_BACKEND=supabase uses the private bucket through the Storage REST API with the
# service role key, server side only; APP_ENV=prod refuses the example URL, the fake key, and a non-https URL.
# Browsers never get a storage URL: the API's photo route proxies the bytes. STORAGE_TIMEOUT_S is per request.
STORAGE_BACKEND=local
STORAGE_TIMEOUT_S=10
STORAGE_DIR=data/generated/storage
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_KEY=fake-service-key
SUPABASE_BUCKET=claim-photos

# Fraud graph (Neo4j Community in docker compose; AuraDB Free in deploy: neo4j+s://<instance>.databases.neo4j.io).
# On AuraDB, NEO4J_USER and NEO4J_DATABASE are both the instance id: copy them from the Aura credentials file.
# Empty NEO4J_URI disables the graph. GRAPH_KEY_SECRET keys the HMAC of addresses, emails, and payout destinations.
NEO4J_URI=bolt://localhost:57687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graph-dev-only
NEO4J_DATABASE=neo4j
NEO4J_NAMESPACE=dev
NEO4J_TIMEOUT_S=3
GRAPH_BACKOFF_S=30
NEO4J_HTTP_PORT=57474
NEO4J_BOLT_PORT=57687
GRAPH_KEY_SECRET=ZmFrZS1ncmFwaC1rZXktc2VjcmV0LTMyLWJ5dGVz
GRAPH_RESYNC_BATCH=25

PHASH_DUPLICATE_BITS=6
DEFAULT_VALUE_THRESHOLD_CENTS=10000

# Worker (make worker). agent needs LLM_MODE=live and a real key; rules_only runs offline at no cost.
ADJUDICATOR=agent
AGENT_VARIANT=loop_full
WORKER_POLL_S=1.0
WORKER_LEASE_S=90
WORKER_MAX_ATTEMPTS=3
WORKER_HEARTBEAT_MAX_AGE_S=300

# Portal links (component 2 serves /claim/[token]).
PORTAL_BASE_URL=http://localhost:3000/claim
MAX_PHOTO_BYTES=8000000
MAX_PHOTO_PIXELS=40000000
PORTAL_RATE_PER_TOKEN_HOUR=60
PORTAL_UPLOADS_PER_TOKEN_HOUR=10
PORTAL_RATE_PER_IP_HOUR=300
TRUSTED_PROXY_HOPS=0

# Campaigns (M5): owner registration uploads (synthetic rows only).
REGISTRATIONS_MAX_BYTES=5000000
REGISTRATIONS_MAX_ROWS=50000
